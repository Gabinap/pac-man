# Pac-Man — main configuration file
# Lines starting with '#' or '//' are comments and will be stripped before parsing.
# Missing or invalid keys are clamped to safe defaults — no traceback, just a log message.

{
    // Path to the highscore save file (relative to the working directory)
    "highscore_filename": "data/highscores.json",

    # Number of lives the player starts with — must be between 1 and 9
    "lives": 1,

    // Points awarded for eating a regular pacgum (small dot)
    "points_per_pacgum": 10,

    # Eating a super-pacgum (power pellet) triggers frightened mode on all ghosts
    "points_per_super_pacgum": 100,

    // A frightened ghost eaten by the player rewards this many points
    "points_per_ghost": 200,

    # Fixed seed for the first level's maze — guarantees a reproducible starting layout

    // Maximum time allowed per level in seconds; set to 0 to disable the timer
    "level_max_time": 90,

    # Level list — each entry is passed to the A-Maze-ing generator.
    # The first level uses the fixed seed above; subsequent levels are randomly seeded.
    # Dimensions must be odd numbers so the generator can produce valid corridors.
    # Optional "ambiance" key sets the visual theme; omit for a random pick each run.
    # Valid ambiances: classic, dungeon, manor, forest, ruins, beach, meme
    "levels": [
        {"width": 11, "height": 11, "difficulty": "medium", "lives": 9},
        {"width": 11, "height": 11, "ambiance": "forest", "difficulty": "medium"},
        {"width": 15, "height": 15, "difficulty": "medium"}
    ]

}
